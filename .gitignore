# =============================================
# Medical RAG Multi-Agent — .gitignore
# =============================================

# Environment / Secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ─── Large Data Files (DO NOT UPLOAD) ───────
# Raw source datasets
data/raw/
MedQuAD/

# Processed corpus files (too large for GitHub, regenerated by pipeline)
data/processed/*.jsonl

# Embedding matrices (91-243 MB, regenerated by embedder)
data/embeddings/*.npy
*.npy

# Qdrant local storage (regenerated by indexer)
data/qdrant_storage/

# Evaluation results (regenerated by eval pipeline)
results/

# ─── Node / Frontend ───────────────────────
node_modules/
.next/
out/
frontend/.env.local

# ─── IDE ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS ────────────────────────────────────
Thumbs.db
.DS_Store

# ─── Logs ──────────────────────────────────
*.log

# ─── Personal Documentation ───────────────
decisions.md
flow.md

# ─── Testing / Coverage ───────────────────
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# ─── Docker ────────────────────────────────
docker-compose.override.yml
