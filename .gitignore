# =============================================
# Medical RAG Multi-Agent — .gitignore
# =============================================

# Environment / Secrets
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ─── Large Data Files (DO NOT UPLOAD) ───────
data/raw/
MedQuAD/
data/processed/*.jsonl
data/embeddings/*.npy
*.npy
data/qdrant_storage/
results/

# ─── Node / Frontend ───────────────────────
node_modules/
.next/
out/
frontend/.env.local
frontend/next-env.d.ts

# ─── IDE ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS ────────────────────────────────────
Thumbs.db
.DS_Store

# ─── Logs ──────────────────────────────────
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ─── Personal Documentation ───────────────
decisions.md
flow.md

# ─── Testing / Coverage ───────────────────
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
coverage
*.lcov
.nyc_output

# ─── Docker ────────────────────────────────
docker-compose.override.yml
