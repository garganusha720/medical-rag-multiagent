# ==========================================
# Medical RAG Multi-Agent — Environment Keys
# ==========================================

# --- Groq (LLM inference) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b        # Active Groq model (see Decision #020)

# --- Cohere (Embeddings — primary) ---
COHERE_API_KEY=

# --- NCBI / PubMed (Data ingestion) ---
NCBI_API_KEY=
NCBI_EMAIL=your_email@example.com

# --- Qdrant (Vector store) ---
# Mode: "local" for development (docker run -p 6333:6333 qdrant/qdrant)
#       "cloud" for production (Qdrant Cloud free tier)
QDRANT_MODE=local
QDRANT_LOCAL_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PING_INTERVAL_DAYS=5

# --- Supabase (Auth + Database) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- LangSmith (Tracing — optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medical-rag

# --- App Config ---
EMBEDDING_MODEL=cohere          # cohere or minilm (no OpenAI needed)
CHUNK_SIZE=256
CHUNK_OVERLAP=32
RETRIEVAL_METHOD=hybrid
HYBRID_ALPHA=0.6
TOP_K=5
PUBMED_FETCH_LIMIT=20000
